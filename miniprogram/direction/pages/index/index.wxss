.page-shell {
  min-height: 100vh;
  padding: 32rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.top-panel {
  background: linear-gradient(180deg, #1c1f44 0%, #163d68 100%);
  border-radius: 40rpx 40rpx 0 0;
  padding: 28rpx 32rpx 40rpx;
  text-align: center;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #ffffff;
}

.avatar-ring {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin: 44rpx auto 0;
  border-radius: 50%;
  border: 8rpx solid rgba(71, 140, 255, 0.45);
  box-shadow: 0 0 0 12rpx rgba(55, 122, 238, 0.18);
}

.avatar-core {
  position: absolute;
  inset: 16rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #5ca6ed, #2c5ead);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-icon {
  font-size: 64rpx;
}

.avatar-dot {
  position: absolute;
  right: -4rpx;
  bottom: 18rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #57de82;
  border: 6rpx solid #1c3560;
}

.avatar-name {
  margin-top: 34rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.avatar-subtitle {
  margin-top: 12rpx;
  color: #7ab4ff;
  font-size: 24rpx;
}

.wave-bars {
  margin-top: 26rpx;
  display: flex;
  justify-content: center;
  gap: 8rpx;
}

.wave-bars text {
  width: 8rpx;
  border-radius: 999rpx;
  background: #59a6ff;
}

.wave-bars text:nth-child(1),
.wave-bars text:nth-child(5) {
  height: 22rpx;
  margin-top: 18rpx;
}

.wave-bars text:nth-child(2),
.wave-bars text:nth-child(4) {
  height: 36rpx;
  margin-top: 10rpx;
}

.wave-bars text:nth-child(3) {
  height: 52rpx;
}

.chat-panel {
  background: #242424;
  border-radius: 0 0 38rpx 38rpx;
  padding: 24rpx;
}

.chat-scroll {
  max-height: 420rpx;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.msg-row-user {
  justify-content: flex-end;
}

.msg-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #264b82;
  color: #d9ecff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.msg-bubble {
  max-width: 78%;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.msg-assistant {
  background: #2c2d31;
  color: #ffffff;
}

.msg-user {
  background: #294b81;
  color: #dcebff;
}

.quick-block {
  margin-top: 18rpx;
}

.quick-title,
.interest-title {
  color: #d8d8d8;
  font-size: 24rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 14rpx;
}

.chip {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 24rpx;
}

.composer-row {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.composer-input {
  flex: 1;
  height: 84rpx;
  border-radius: 999rpx;
  background: #2c2c2c;
  padding: 0 30rpx;
  color: #ffffff;
  font-size: 26rpx;
}

.mic-btn {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #315f9d;
  color: #dcecff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tool-row {
  margin-top: 18rpx;
  display: flex;
  gap: 14rpx;
}

.tool-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 18rpx;
  background: #363d53;
  color: #ffffff;
  font-size: 24rpx;
}

.tool-btn.primary {
  background: #2f5d97;
}

.tool-btn.ghost {
  background: rgba(255, 255, 255, 0.08);
}

.route-panel {
  margin-top: 26rpx;
  padding: 28rpx;
}

.route-title {
  font-size: 42rpx;
  font-weight: 700;
}

.route-subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #c0c5db;
}

.route-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 26rpx;
}

.route-blue {
  background: #294b81;
}

.route-green {
  background: #1f5c1b;
}

.route-name {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.route-stop {
  margin-top: 8rpx;
  color: #dfe9fb;
  font-size: 25rpx;
}

.dark-chip {
  background: rgba(255, 255, 255, 0.04);
}

.route-action {
  margin-top: 24rpx;
  height: 86rpx;
  line-height: 86rpx;
  border-radius: 22rpx;
  background: #2f5d97;
  color: #eaf2ff;
  font-size: 30rpx;
}

.audio-status {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #aab8db;
  word-break: break-all;
}

.error-box {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(143, 38, 38, 0.32);
  color: #ffd4d4;
  font-size: 22rpx;
}
