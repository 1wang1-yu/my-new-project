.page-shell {
  min-height: 100vh;
  padding: 32rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.top-panel {
  background: linear-gradient(180deg, #1c1f44 0%, #163d68 100%);
  border-radius: 40rpx 40rpx 0 0;
  padding: 28rpx 32rpx 40rpx;
  text-align: center;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #ffffff;
}

/* ===== 3D 数字人 Canvas ===== */
.avatar-stage {
  position: relative;
  width: 280rpx;
  height: 320rpx;
  margin: 16rpx auto 0;
}

.avatar-glow {
  position: absolute;
  top: 10rpx;
  right: 0;
  bottom: 20rpx;
  left: 0;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(71, 140, 255, 0.2) 0%, transparent 70%);
}

.avatar-canvas {
  position: relative;
  width: 280rpx;
  height: 320rpx;
  z-index: 2;
}

/* 说话指示器 */
.speaking-indicator {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 8rpx;
  z-index: 3;
  opacity: 0.4;
  transition: opacity 0.3s;
}

.speaking-indicator.active {
  opacity: 1;
}

.si-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #57de82;
}

.speaking-indicator.active .si-dot:nth-child(1) {
  animation: siBounce 0.6s ease-in-out infinite;
}
.speaking-indicator.active .si-dot:nth-child(2) {
  animation: siBounce 0.6s ease-in-out 0.15s infinite;
}
.speaking-indicator.active .si-dot:nth-child(3) {
  animation: siBounce 0.6s ease-in-out 0.3s infinite;
}
.speaking-indicator.active .si-dot:nth-child(4) {
  animation: siBounce 0.6s ease-in-out 0.45s infinite;
}

@keyframes siBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

.avatar-name {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.avatar-subtitle {
  margin-top: 8rpx;
  color: #7ab4ff;
  font-size: 24rpx;
}

/* 声波动画 */
.wave-bars {
  margin-top: 20rpx;
  display: flex;
  justify-content: center;
  gap: 8rpx;
}

.wave-bars text {
  width: 8rpx;
  border-radius: 999rpx;
  background: #59a6ff;
  transition: height 0.3s, margin-top 0.3s;
}

.wave-bars text:nth-child(1),
.wave-bars text:nth-child(5) {
  height: 22rpx;
  margin-top: 18rpx;
}

.wave-bars text:nth-child(2),
.wave-bars text:nth-child(4) {
  height: 36rpx;
  margin-top: 10rpx;
}

.wave-bars text:nth-child(3) {
  height: 52rpx;
}

.wave-bars.active text {
  animation: waveAnim 0.7s ease-in-out infinite;
}
.wave-bars.active text:nth-child(1) { animation-delay: 0s; }
.wave-bars.active text:nth-child(2) { animation-delay: 0.1s; }
.wave-bars.active text:nth-child(3) { animation-delay: 0.2s; }
.wave-bars.active text:nth-child(4) { animation-delay: 0.3s; }
.wave-bars.active text:nth-child(5) { animation-delay: 0.4s; }

@keyframes waveAnim {
  0%, 100% { transform: scaleY(1); }
  50% { transform: scaleY(2.2); }
}

.chat-panel {
  background: #242424;
  border-radius: 0 0 38rpx 38rpx;
  padding: 24rpx;
}

.chat-scroll {
  max-height: 420rpx;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.msg-row-user {
  justify-content: flex-end;
}

.msg-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #264b82;
  color: #d9ecff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.msg-bubble {
  max-width: 78%;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.msg-assistant {
  background: #2c2d31;
  color: #ffffff;
}

.msg-user {
  background: #294b81;
  color: #dcebff;
}

.quick-block {
  margin-top: 18rpx;
}

.quick-title,
.interest-title {
  color: #d8d8d8;
  font-size: 24rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 14rpx;
}

.chip {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 24rpx;
}

.composer-row {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.composer-input {
  flex: 1;
  height: 84rpx;
  border-radius: 999rpx;
  background: #2c2c2c;
  padding: 0 30rpx;
  color: #ffffff;
  font-size: 26rpx;
}

.mic-btn {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #315f9d;
  color: #dcecff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tool-row {
  margin-top: 18rpx;
  display: flex;
  gap: 14rpx;
}

.tool-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 18rpx;
  background: #363d53;
  color: #ffffff;
  font-size: 24rpx;
}

.tool-btn.primary {
  background: #2f5d97;
}

.tool-btn.active {
  background: #3d8b40;
}

.tool-btn.ghost {
  background: rgba(255, 255, 255, 0.08);
}

.route-panel {
  margin-top: 26rpx;
  padding: 28rpx;
}

.route-title {
  font-size: 42rpx;
  font-weight: 700;
}

.route-subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #c0c5db;
}

.route-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 26rpx;
}

.route-blue {
  background: #294b81;
}

.route-green {
  background: #1f5c1b;
}

.route-name {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.route-stop {
  margin-top: 8rpx;
  color: #dfe9fb;
  font-size: 25rpx;
}

.dark-chip {
  background: rgba(255, 255, 255, 0.04);
}

.route-action {
  margin-top: 24rpx;
  height: 86rpx;
  line-height: 86rpx;
  border-radius: 22rpx;
  background: #2f5d97;
  color: #eaf2ff;
  font-size: 30rpx;
}

.error-box {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(143, 38, 38, 0.32);
  color: #ffd4d4;
  font-size: 22rpx;
}

