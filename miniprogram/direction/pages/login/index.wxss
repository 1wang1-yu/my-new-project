.page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #3D8B7E 0%, #2D6B5E 40%, #F2F4F3 40%);
  padding: 40rpx;
}

.login-box {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 48rpx 48rpx;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.12);
  text-align: center;
}

.logo { font-size: 80rpx; margin-bottom: 16rpx; }
.title { font-size: 40rpx; font-weight: 700; color: #1a1a2e; }
.subtitle { font-size: 26rpx; color: #999; margin-top: 8rpx; margin-bottom: 40rpx; }

.input {
  width: 100%; height: 88rpx; background: #f5f5f5; border-radius: 16rpx;
  padding: 0 28rpx; font-size: 28rpx; margin-bottom: 20rpx; box-sizing: border-box;
}

.row { display: flex; gap: 20rpx; margin-bottom: 20rpx; }
.half { flex: 1; margin-bottom: 0; }

.picker {
  height: 88rpx; background: #f5f5f5; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
}
.picker.half { flex: 1; }
.picker-text { font-size: 28rpx; color: #999; }

.btn-primary {
  width: 100%; height: 88rpx; background: linear-gradient(135deg, #3D8B7E, #2D6B5E);
  color: #fff; border-radius: 16rpx; font-size: 32rpx; font-weight: 600;
  line-height: 88rpx; margin-top: 20rpx; margin-bottom: 24rpx;
}
.btn-primary::after { border: none; }
.switch { font-size: 26rpx; color: #3D8B7E; text-decoration: underline; }
