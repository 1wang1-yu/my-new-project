.page-shell {
  padding: 24rpx 28rpx;
  min-height: 100vh;
  background: #F2F4F3;
}

.header-bar { margin-bottom: 24rpx; }
.header-greeting { font-size: 40rpx; font-weight: 700; color: #1a1a2e; }
.header-scenic { font-size: 26rpx; color: #7A8B87; margin-top: 6rpx; }

/* 会话提示 */
.session-hint {
  background: #E8F5E9;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #2E7D32;
  font-weight: 500;
}

/* 区块 */
.section-block {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 16rpx;
}
.section-subtitle {
  font-size: 22rpx;
  color: #3D8B7E;
  font-weight: 400;
}

/* 兴趣标签 */
.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.tag {
  padding: 12rpx 28rpx;
  border-radius: 999px;
  font-size: 26rpx;
  background: #f0f0f0;
  color: #aaa;
  border: 2rpx solid #e0e0e0;
  transition: all 0.2s;
}
.tag:active { transform: scale(0.95); }
.tag-on {
  background: #3D8B7E;
  color: #fff;
  border-color: #3D8B7E;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(61,139,126,0.3);
}

/* 自定义偏好输入 */
.pref-input-wrap {
  background: #f8f9f8;
  border-radius: 16rpx;
  border: 2rpx solid #e8e8e8;
  padding: 16rpx;
}
.pref-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
}
.pref-hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 景点选择网格 */
.attraction-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.attraction-item {
  position: relative;
  padding: 14rpx 24rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  background: #f8f9f8;
  color: #555;
  border: 2rpx solid #e8e8e8;
  transition: all 0.2s;
}
.attraction-item:active { transform: scale(0.95); }
.attraction-on {
  background: #FFF8E1;
  color: #F57F17;
  border-color: #FFD54F;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(255,193,7,0.2);
}
.attraction-check {
  margin-left: 8rpx;
  font-weight: 700;
}
.attraction-loading, .attraction-empty {
  font-size: 24rpx;
  color: #999;
  padding: 20rpx 0;
  text-align: center;
}

/* 时间 */
.time-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.time-picker {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 32rpx;
  border: 1rpx solid #ddd;
  border-radius: 16rpx;
  background: #f9f9f9;
  min-width: 140rpx;
}
.time-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 6rpx;
}
.time-value {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}
.time-sep {
  font-size: 36rpx;
  color: #ccc;
}
.duration-badge {
  padding: 8rpx 20rpx;
  background: #E8F2F0;
  color: #3D8B7E;
  border-radius: 999px;
  font-size: 24rpx;
  white-space: nowrap;
}

/* 操作按钮 */
.action-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.route-btn {
  flex: 1;
  height: 88rpx;
  background: linear-gradient(135deg, #3D8B7E, #2D6B5E);
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
}
.route-btn::after { border: none; }

.clear-btn {
  width: 160rpx;
  height: 88rpx;
  background: #fff;
  color: #999;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 88rpx;
  border: 2rpx solid #e0e0e0;
}
.clear-btn::after { border: none; }
.clear-btn:active { background: #f5f5f5; }

/* 路线结果 */
.route-list { display: flex; flex-direction: column; gap: 20rpx; }
.route-card { background: #fff; border-radius: 20rpx; padding: 24rpx; }
.route-card-head { display: flex; align-items: center; gap: 14rpx; margin-bottom: 16rpx; }
.route-dot {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 700; color: #fff; flex-shrink: 0;
}
.dot-primary { background: linear-gradient(135deg, #3D8B7E, #2D6B5E); }
.dot-secondary { background: linear-gradient(135deg, #7A8B87, #5A6B67); }
.route-card-title { flex: 1; }
.route-name { font-size: 28rpx; font-weight: 600; color: #1a1a2e; }
.route-time { font-size: 22rpx; color: #999; margin-left: 12rpx; }
.route-stops { display: flex; flex-direction: column; gap: 12rpx; margin-bottom: 12rpx; }
.route-stop-item {
  display: flex; align-items: flex-start; gap: 14rpx;
  padding: 14rpx 16rpx; background: #f8f9f8; border-radius: 14rpx;
  border-left: 4rpx solid #3D8B7E;
}
.stop-time {
  font-size: 22rpx; color: #3D8B7E; font-weight: 600;
  flex-shrink: 0; padding-top: 2rpx; min-width: 110rpx;
}
.stop-info { flex: 1; }
.stop-name { font-size: 26rpx; font-weight: 600; color: #1a1a2e; }
.stop-desc { font-size: 22rpx; color: #888; margin-top: 4rpx; display: block; }
.route-highlights { display: flex; flex-wrap: wrap; gap: 8rpx; }
.highlight-tag { font-size: 22rpx; color: #3D8B7E; background: #E8F2F0; padding: 6rpx 14rpx; border-radius: 8rpx; }

/* 空状态 */
.empty-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  color: #bbb;
}
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: #999; }
.empty-sub { font-size: 24rpx; color: #ccc; margin-top: 8rpx; }
