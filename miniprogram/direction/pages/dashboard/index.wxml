<view class="page-shell">

  <!-- 用户信息卡片 -->
  <view class="profile-card card">
    <view class="profile-avatar" wx:if="{{!avatarUrl}}">👤</view>
    <image class="profile-avatar-img" wx:else src="{{avatarUrl}}" mode="aspectFill" />
    <view class="profile-name">{{nickName || t.userName}}</view>
    <view class="profile-stats">
      <view class="ps-item">
        <text class="ps-num">{{totalChats}}</text>
        <text class="ps-label">{{t.statChats}}</text>
      </view>
      <view class="ps-divider"></view>
      <view class="ps-item">
        <text class="ps-num">{{totalMessages}}</text>
        <text class="ps-label">{{t.statMsgs}}</text>
      </view>
      <view class="ps-divider"></view>
      <view class="ps-item">
        <text class="ps-num">{{totalDays}}</text>
        <text class="ps-label">{{t.statDays}}</text>
      </view>
    </view>
  </view>

  <!-- 功能入口卡片 -->
  <view class="menu-section">

    <view class="menu-card card" bindtap="openSettings">
      <view class="menu-icon">⚙️</view>
      <view class="menu-info">
        <text class="menu-title">{{t.settingsTitle}}</text>
        <text class="menu-sub">{{settingsSummary}}</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-card card" bindtap="openHistory">
      <view class="menu-icon">💬</view>
      <view class="menu-info">
        <text class="menu-title">{{t.historyTitle}}</text>
        <text class="menu-sub">{{historySummary}}</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-card card logout" bindtap="onLogout">
      <view class="menu-icon">🚪</view>
      <view class="menu-info">
        <text class="menu-title" style="color:#d94a3a;">退出登录</text>
        <text class="menu-sub">清除登录信息</text>
      </view>
      <text class="menu-arrow" style="color:#d94a3a;">›</text>
    </view>

  </view>

</view>
