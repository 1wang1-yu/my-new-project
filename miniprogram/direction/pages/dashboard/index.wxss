page {
  background: #1f1f1f;
}

.admin-page {
  height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.admin-header {
  padding: 26rpx 28rpx;
}

.brand-box {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.brand-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  background: #274f8e;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e7f0ff;
  font-size: 30rpx;
  font-weight: 700;
}

.brand-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
}

.brand-sub {
  margin-top: 8rpx;
  color: #bfc5d4;
  font-size: 22rpx;
}

.nav-row {
  display: flex;
  gap: 26rpx;
  margin-top: 22rpx;
  color: #d2d6e5;
  font-size: 24rpx;
}

.nav-item.active {
  color: #6da5ff;
}

.stats-grid,
.board-grid,
.bottom-grid {
  display: grid;
  gap: 20rpx;
  margin-top: 20rpx;
}

.stats-grid {
  grid-template-columns: repeat(2, 1fr);
}

.board-grid,
.bottom-grid {
  grid-template-columns: 1fr;
}

.stat-card,
.panel {
  padding: 24rpx;
}

.stat-title {
  color: #d9ddeb;
  font-size: 24rpx;
}

.stat-value {
  margin-top: 12rpx;
  font-size: 54rpx;
  font-weight: 700;
  color: #ffffff;
}

.unit {
  font-size: 28rpx;
  margin-left: 4rpx;
}

.stat-trend {
  margin-top: 10rpx;
  color: #d6c48a;
  font-size: 22rpx;
}

.stat-trend.positive,
.knowledge-ok {
  color: #7ee66d;
}

.bar-chart {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
  margin-top: 26rpx;
  height: 180rpx;
}

.bar {
  flex: 1;
  border-radius: 10rpx 10rpx 0 0;
}

.bar.blue {
  background: #2d4e82;
}

.bar.green {
  background: #4dd573;
}

.week-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  color: #d7d7d7;
  font-size: 22rpx;
}

.progress-item {
  margin-top: 18rpx;
}

.progress-label,
.config-row,
.rank-row,
.date-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.progress-label,
.rank-question,
.config-row,
.report-line,
.knowledge-item {
  color: #e8e8e8;
  font-size: 24rpx;
}

.progress-track {
  margin-top: 10rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: #343434;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
}

.positive-bar {
  background: #4dd573;
}

.neutral-bar {
  background: #7b7b7b;
}

.negative-bar {
  background: #893434;
}

.rank-row {
  margin-top: 16rpx;
}

.rank-index {
  width: 30rpx;
  color: #7aa1ff;
}

.rank-question {
  flex: 1;
}

.rank-count {
  color: #efe5b8;
  font-size: 22rpx;
}

.knowledge-item {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
}

.knowledge-update {
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: #71510a;
  color: #f6d688;
  font-size: 22rpx;
}

.config-row,
.report-box {
  margin-top: 16rpx;
}

.config-value {
  flex: 1;
  text-align: right;
  word-break: break-all;
  color: #b9cfff;
}

.field-input {
  flex: 1;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  color: #ffffff;
  font-size: 24rpx;
}

.spaced {
  margin-top: 14rpx;
}

.primary-btn,
.secondary-btn {
  margin-top: 18rpx;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 16rpx;
  color: #ffffff;
  font-size: 24rpx;
}

.primary-btn {
  background: #2f5d97;
}

.secondary-btn {
  background: #2b2b2b;
}

.report-box {
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.03);
}

.error-box {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(143, 38, 38, 0.32);
  color: #ffd4d4;
  font-size: 22rpx;
}
