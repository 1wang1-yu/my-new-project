page { background: #F2F4F3; }

.page-shell { min-height: 100vh; padding: 24rpx; box-sizing: border-box; }

.card { background: #FFF; border-radius: 20rpx; border: 1rpx solid rgba(61,139,126,0.06); box-shadow: 0 4rpx 24rpx rgba(30,45,43,0.04); }

/* profile card */
.profile-card { padding: 40rpx 32rpx 32rpx; text-align: center; margin-bottom: 28rpx; }
.profile-avatar { width: 120rpx; height: 120rpx; margin: 0 auto 16rpx; border-radius: 50%; background: linear-gradient(135deg, #E8F2F0, #F2F4F3); border: 2rpx solid rgba(61,139,126,0.12); display: flex; align-items: center; justify-content: center; font-size: 56rpx; }
.profile-avatar-img { width: 120rpx; height: 120rpx; margin: 0 auto 16rpx; border-radius: 50%; display: block; object-fit: cover; }
.profile-name { font-size: 36rpx; font-weight: 700; color: #1E2D2B; margin-bottom: 6rpx; }
.profile-stats { display: flex; align-items: center; justify-content: center; }
.ps-item { flex: 1; }
.ps-num { display: block; font-size: 44rpx; font-weight: 700; color: #3D8B7E; }
.ps-label { display: block; margin-top: 4rpx; font-size: 22rpx; color: #7A8B87; }
.ps-divider { width: 2rpx; height: 48rpx; background: rgba(61,139,126,0.1); flex-shrink: 0; }

/* menu cards */
.menu-section { display: flex; flex-direction: column; gap: 14rpx; }
.menu-card { padding: 28rpx 24rpx; display: flex; align-items: center; gap: 18rpx; }
.menu-card:active { transform: scale(0.98); background: #F7FAF9; }
.menu-icon { font-size: 44rpx; flex-shrink: 0; }
.menu-info { flex: 1; overflow: hidden; }
.menu-title { display: block; font-size: 30rpx; font-weight: 600; color: #1E2D2B; }
.menu-sub { display: block; font-size: 24rpx; color: #7A8B87; margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.menu-arrow { font-size: 40rpx; color: #C5D5D1; flex-shrink: 0; }
