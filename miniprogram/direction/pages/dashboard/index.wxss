page {
  background: #F2F4F3;
}

.profile-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

/* ============================================
   用户信息卡片
   ============================================ */
.profile-card {
  padding: 40rpx 32rpx 32rpx;
  text-align: center;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 16rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8F2F0, #F2F4F3);
  border: 2rpx solid rgba(61, 139, 126, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1E2D2B;
  margin-bottom: 6rpx;
}

.profile-sub {
  font-size: 24rpx;
  color: #7A8B87;
  margin-bottom: 28rpx;
}

.profile-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
}

.ps-item {
  flex: 1;
}

.ps-num {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #3D8B7E;
}

.ps-label {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #7A8B87;
}

.ps-divider {
  width: 2rpx;
  height: 48rpx;
  background: rgba(61, 139, 126, 0.1);
  flex-shrink: 0;
}

/* ============================================
   聊天记录
   ============================================ */
.history-section {
  margin-top: 28rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 4rpx 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1E2D2B;
}

.section-count {
  margin-left: auto;
  padding: 2rpx 14rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  background: #3D8B7E;
  border-radius: 999rpx;
}

.history-card {
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  transition: all 0.15s;
}

.history-card:active {
  transform: scale(0.98);
  background: #F7FAF9;
}

.hc-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.hc-date {
  font-size: 24rpx;
  color: #1E2D2B;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.hc-date-icon {
  font-size: 24rpx;
}

.hc-time {
  font-size: 22rpx;
  color: #7A8B87;
}

.hc-preview {
  font-size: 26rpx;
  color: #5A6B67;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.hc-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hc-count {
  font-size: 22rpx;
  color: #7A8B87;
}

.hc-arrow {
  font-size: 24rpx;
  color: #3D8B7E;
  font-weight: 500;
}

/* ============================================
   空状态
   ============================================ */
.empty-state {
  padding: 80rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #7A8B87;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #B5C1BD;
}

/* ============================================
   内联对话详情
   ============================================ */
.inline-detail {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(61, 139, 126, 0.08);
  max-height: 480rpx;
  overflow-y: auto;
}

.dmsg {
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  margin-bottom: 14rpx;
}

.dmsg:last-child {
  margin-bottom: 0;
}

.dmsg-user {
  background: linear-gradient(135deg, #3D8B7E, #2C6B60);
  color: #FFFFFF;
}

.dmsg-assistant {
  background: #F2F4F3;
  color: #1E2D2B;
}

.dmsg-role {
  display: block;
  font-size: 20rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  opacity: 0.7;
}

.dmsg-content {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  word-break: break-all;
}

/* ============================================
   操作区
   ============================================ */
.action-section {
  margin-top: 32rpx;
  padding-bottom: 48rpx;
}

.clear-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  color: #D94A3A;
  font-size: 28rpx;
  font-weight: 500;
  border: 1rpx solid rgba(217, 74, 58, 0.15);
  text-align: center;
  transition: all 0.15s;
}

.clear-btn:active {
  background: #FEF3F2;
}

.action-hint {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B5C1BD;
}
