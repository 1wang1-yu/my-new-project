page {
  min-height: 100%;
  background: #F2F4F3;
  color: #1E2D2B;
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
}

button {
  border: none;
  padding: 0;
  margin: 0;
  line-height: inherit;
  font-size: inherit;
  background: transparent;
}

button::after {
  border: none;
}

input {
  border: none;
  outline: none;
  background: transparent;
}

.card {
  background: #FFFFFF;
  border: 1rpx solid rgba(61, 139, 126, 0.06);
  box-shadow: 0 4rpx 24rpx rgba(30, 45, 43, 0.04);
  border-radius: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E2D2B;
}

.section-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7A8B87;
}
