page {
  min-height: 100%;
  background:
    radial-gradient(circle at top center, rgba(50, 89, 212, 0.18), transparent 28%),
    linear-gradient(180deg, #1a1d37 0%, #153964 46%, #242424 46.2%, #242424 100%);
  color: #f4f5fb;
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
}

button {
  border: none;
}

button::after {
  border: none;
}

.card {
  background: rgba(39, 40, 48, 0.95);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 26rpx 80rpx rgba(0, 0, 0, 0.28);
  border-radius: 32rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.section-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #b8bdd6;
}
